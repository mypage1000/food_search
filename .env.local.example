# ─────────────────────────────────────────────────────────────
#  city-tour-food-map — 환경변수 예시
#
#  1) 이 파일을 복사해 `.env.local` 을 만드세요.
#       cp .env.local.example .env.local
#  2) `.env.local` 에만 실제 값을 채우세요.
#  3) 이 파일(.env.local.example)에는 값을 절대 넣지 마세요. 커밋되는 파일입니다.
#
#  ※ 자세한 규칙은 PRD.md §5 참고
# ─────────────────────────────────────────────────────────────


# ══════════════════════════════════════════════════════════════
#  A등급 — 서버 전용. 브라우저에 절대 노출 금지
#  ▸ NEXT_PUBLIC_ 접두사를 붙이는 순간 번들에 박혀 공개됩니다.
#  ▸ app/api/ 아래 서버 코드에서만 참조하세요.
# ══════════════════════════════════════════════════════════════

# 문화공공데이터광장 맞춤형 API 서비스키 (맛집 데이터)
# https://www.culture.go.kr/data/
CULTURE_API_KEY=

# 공공데이터포털 서비스키 (전국시티투어정보표준데이터)
# https://www.data.go.kr/
# ⚠️ Encoding / Decoding 두 종류가 발급됩니다.
#    어느 쪽을 넣었는지 기억해 두고, 코드에서 이중 인코딩이 되지 않게 하세요.
#    (인증 실패의 가장 흔한 원인입니다)
DATA_GO_KR_SERVICE_KEY=

# 카카오 REST API 키 (주소 → 좌표 지오코딩. 서버에서만 호출)
# https://developers.kakao.com/ → 내 애플리케이션 → 앱 키 → REST API 키
# ⚠️ 아래 JS 키와 서로 다른 키입니다. 절대 바꿔 넣지 마세요.
KAKAO_REST_API_KEY=


# ══════════════════════════════════════════════════════════════
#  B등급 — 브라우저 노출 전제 (숨길 방법이 없음)
#  ▸ 방어 수단은 "숨기기"가 아니라 "도메인 제한"입니다.
#  ▸ 카카오 개발자 콘솔 → 앱 설정 → 플랫폼 → Web 사이트 도메인에
#      http://localhost:3000
#      https://<프로젝트>.vercel.app
#    를 등록하세요. 등록하지 않으면 지도가 아예 뜨지 않습니다.
# ══════════════════════════════════════════════════════════════

# 카카오맵 JavaScript 키
# https://developers.kakao.com/ → 내 애플리케이션 → 앱 키 → JavaScript 키
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=
